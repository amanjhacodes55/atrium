# Every setting is optional. On Netlify, storage is Netlify Blobs and needs no configuration.

# Folder for accounts and files when not on Netlify (default ./.data).
# ATRIUM_DATA_DIR=./.data
# Force file storage even on Netlify (fs) — mostly for testing.
# ATRIUM_STORAGE=fs
# Set to false to stop new sign-ups and guest workspaces.
# ATRIUM_ALLOW_SIGNUP=true
# Storage per account, in MB (default 500).
# ATRIUM_QUOTA_MB=500
# Largest single upload, in MB (default 50, or 4.5 on Netlify because of its 6 MB request limit).
# ATRIUM_MAX_UPLOAD_MB=50
